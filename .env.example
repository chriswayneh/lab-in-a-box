# =============================================================================
# Lab-in-a-Box — environment configuration
# =============================================================================
#
#   cp .env.example .env      # or, preferred:  make secrets
#
# `make secrets` copies this file and replaces every CHANGEME_* placeholder
# with a cryptographically random value. Nothing else in the repo needs to be
# edited by hand.
#
# Every value below has a safe fallback baked into the compose files, so
# `docker compose up -d` works even with no .env present — it just runs with
# well-known development credentials. See docs/security.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Compose project name — prefixes every container, network and volume.
COMPOSE_PROJECT_NAME=lab

# File-backed credentials generated by `make secrets` live here. Leave this
# alone unless you deliberately keep local credentials somewhere else.
LAB_SECRETS_DIR=./secrets/local

# Base domain. Every service is published at <service>.${LAB_DOMAIN}.
# `.localhost` resolves to 127.0.0.1 on all modern OSes (RFC 6761) — no hosts
# file editing required. Point this at a real domain for a remote deployment.
LAB_DOMAIN=lab.localhost

# Host ports bound by Traefik. Change these if 80/443 are already in use.
LAB_HTTP_PORT=80
LAB_HTTPS_PORT=443

# Timezone applied to every container, so log timestamps line up.
LAB_TZ=UTC

# Redirect all HTTP traffic to HTTPS. Off by default: the lab ships with a
# self-signed certificate, and forcing HTTPS makes the first run a wall of
# browser warnings. Turn on once you supply a real certificate.
LAB_FORCE_HTTPS=false

# Optional services, comma-separated. Anything not listed here stays stopped.
#   qdrant      vector database for retrieval-augmented generation
#   watchtower  unattended container updates
# e.g. COMPOSE_PROFILES=qdrant,watchtower
#
# GPU support is not a profile — it is an override file. Use `make up GPU=1`.
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# PostgreSQL  — shared relational store (Keycloak, Gitea, app schemas)
# -----------------------------------------------------------------------------
POSTGRES_USER=lab
POSTGRES_DB=lab
# The superuser password is a Docker secret (secrets/local/postgres_password.txt
# after `make secrets`; otherwise secrets/postgres_password.txt),
# not an environment variable. These two are per-service roles created by
# configs/postgres/init/ — each service gets its own login, scoped to its own
# database, so a compromise of one cannot read another's tables.
KEYCLOAK_DB_PASSWORD=CHANGEME_KEYCLOAK_DB_PASSWORD
GITEA_DB_PASSWORD=CHANGEME_GITEA_DB_PASSWORD
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis — cache / session store
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Keycloak — identity provider (OIDC / SAML)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME_KEYCLOAK_ADMIN_PASSWORD
# Realm imported automatically from configs/keycloak/realm-export.json
KEYCLOAK_REALM=lab
# Shared password for the seeded demo users (alice, bob, carol, dave).
DEMO_USER_PASSWORD=CHANGEME_DEMO_USER_PASSWORD
# OIDC client secret used by Grafana's SSO integration.
KEYCLOAK_GRAFANA_CLIENT_SECRET=CHANGEME_KEYCLOAK_GRAFANA_CLIENT_SECRET
# OAuth client used by SCIM provisioning tools. Obtain a short-lived bearer
# token with `make scim-token`; the secret itself is never put in a URL.
KEYCLOAK_SCIM_CLIENT_SECRET=CHANGEME_KEYCLOAK_SCIM_CLIENT_SECRET
# How often the downstream Gitea/Grafana reconciler compares live Keycloak
# state. Failed targets back off independently up to five minutes.
SCIM_SYNC_INTERVAL=15

# -----------------------------------------------------------------------------
# HashiCorp Vault — secrets management
# -----------------------------------------------------------------------------
# The lab runs Vault in dev mode: in-memory, auto-unsealed, single root token.
# This is a demonstration posture, NOT a production one. docs/security.md
# explains what changes for a real deployment.
VAULT_DEV_ROOT_TOKEN=CHANGEME_VAULT_ROOT_TOKEN

# -----------------------------------------------------------------------------
# MinIO — S3-compatible object storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=labadmin
# Consumed as a Docker secret (secrets/local/minio_root_password.txt after
# `make secrets`; otherwise secrets/minio_root_password.txt).
# Buckets created automatically on first boot by the minio-init container.
MINIO_DEFAULT_BUCKETS=lab-artifacts,lab-backups,lab-datasets,loki-chunks

# -----------------------------------------------------------------------------
# Gitea — self-hosted Git service
# -----------------------------------------------------------------------------
GITEA_ADMIN_USER=labadmin
GITEA_ADMIN_PASSWORD=CHANGEME_GITEA_ADMIN_PASSWORD
GITEA_ADMIN_EMAIL=labadmin@lab.example.com
# SSH port for `git clone ssh://...`. Bound on the host.
GITEA_SSH_PORT=2222

# -----------------------------------------------------------------------------
# Grafana — dashboards
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Consumed as a Docker secret (secrets/local/grafana_admin_password.txt after
# `make secrets`; otherwise secrets/grafana_admin_password.txt).
# Enable Keycloak single sign-on for Grafana (requires the lab realm).
GRAFANA_OIDC_ENABLED=false

# -----------------------------------------------------------------------------
# Prometheus / Loki — retention
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=4GB
LOKI_RETENTION_PERIOD=168h

# -----------------------------------------------------------------------------
# AI stack — Ollama + Open WebUI
# -----------------------------------------------------------------------------
# Models pulled automatically on first boot (comma-separated).
# The default is deliberately small (~1.3 GB) so the lab is usable in minutes.
# Bigger, better options: llama3.1:8b, mistral:7b, gemma2:9b, qwen2.5:7b
OLLAMA_DEFAULT_MODELS=llama3.2:1b
# Set to `gpu` in COMPOSE_PROFILES to enable NVIDIA passthrough for Ollama.
OLLAMA_KEEP_ALIVE=5m
# Signs Open WebUI session cookies.
OPENWEBUI_SECRET_KEY=CHANGEME_OPENWEBUI_SECRET_KEY
# Set false to skip authentication entirely (single-user machines only).
OPENWEBUI_AUTH=true
# Vector store backing document retrieval. `chroma` is embedded and needs
# nothing else running. Set to `qdrant` only if you also add qdrant to
# COMPOSE_PROFILES, or Open WebUI will fail to reach a store that isn't there.
OPENWEBUI_VECTOR_DB=chroma

# -----------------------------------------------------------------------------
# Database admin tools
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=labadmin@lab.example.com
PGADMIN_PASSWORD=CHANGEME_PGADMIN_PASSWORD

# -----------------------------------------------------------------------------
# Watchtower — automatic container updates
# -----------------------------------------------------------------------------
# Off by default: silent updates are great for a homelab and terrible for a
# reproducible demo. Add `watchtower` to COMPOSE_PROFILES above to enable it;
# `make update` performs the same job on demand without the daemon.
# Six-field cron (with seconds). Default: 04:00 daily.
WATCHTOWER_SCHEDULE=0 0 4 * * *

# -----------------------------------------------------------------------------
# Traefik
# -----------------------------------------------------------------------------
# Expose the Traefik dashboard at traefik.${LAB_DOMAIN}.
TRAEFIK_DASHBOARD_ENABLED=true
# Requests per second allowed per client IP before Traefik starts shedding load.
TRAEFIK_RATE_LIMIT_AVERAGE=100
TRAEFIK_RATE_LIMIT_BURST=200
# Log level: DEBUG | INFO | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO
