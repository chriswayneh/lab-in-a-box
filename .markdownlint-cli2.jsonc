// =============================================================================
// markdownlint
// =============================================================================
// Documentation style, enforced so that reviews can be about content.
// Rules that are disabled below are disabled for a stated reason.
// =============================================================================
{
  "config": {
    "default": true,

    // MD013 line-length. Prose is wrapped by the editor, not by hand, and the
    // README contains tables and URLs that cannot be wrapped at all without
    // breaking them.
    "MD013": false,

    // MD024 no-duplicate-heading. The roadmap and docs legitimately repeat
    // headings such as "Why" and "How" under different parents.
    "MD024": { "siblings_only": true },

    // MD033 inline HTML. Used deliberately for badge rows, collapsible
    // sections and image alignment, none of which Markdown can express.
    "MD033": false,

    // MD041 first line must be a heading. The README opens with a centred
    // banner block, which is the convention for this kind of project.
    "MD041": false,

    // MD046 code block style — fenced everywhere, never indented.
    "MD046": { "style": "fenced" },

    // Consistent emphasis and list markers keep diffs small. Asterisk for both,
    // because underscore emphasis breaks on intraword use — `snake_case_name`
    // renders as italics in several Markdown implementations.
    "MD004": { "style": "dash" },
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },

    // Ordered lists numbered 1. 1. 1. so inserting an item does not renumber
    // the rest of the list and blow up the diff.
    "MD029": { "style": "one" }
  },

  "globs": ["**/*.md"],

  "ignores": [
    "node_modules/**",
    ".git/**",
    "backups/**",
    // Generated by `make docs` — style is the generator's concern.
    "docs/SERVICES.md"
  ]
}
