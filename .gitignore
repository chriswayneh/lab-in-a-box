# ---------------------------------------------------------------------------
# Local environment — generated by `make secrets`, never committed.
# ---------------------------------------------------------------------------
.env
.env.local
# `make secrets FORCE=1` writes .env.bak.<timestamp>. The trailing wildcard is
# load-bearing: a bare `*.env.bak` does not match a timestamped suffix, and the
# backup contains every credential the old .env did.
.env.bak*
*.env.bak*

# ---------------------------------------------------------------------------
# Runtime state
#
# secrets/*.txt holds tracked, clearly-labelled development defaults so a bare
# `docker compose up -d` works from a fresh clone. `make secrets` instead
# writes private credentials to secrets/local/, which Compose selects through
# .env. The local directory must never be committed.
# ---------------------------------------------------------------------------
secrets/local/
# Lifecycle records written by `make jml-*`. These describe real identities in
# a real lab and are evidence, not source. Redacted of secrets by
# scripts/identity/record.py, but still nobody else's business.
artifacts/

backups/*
!backups/.gitkeep
data/
volumes/

# Copied in by `make https-on` from configs/traefik/optional/ — generated
# state, not source.
configs/traefik/dynamic/https-redirect.yml
# Written by scripts/enable-local-tls.ps1 after mkcert creates a certificate.
# It must remain local because it references the ignored private key.
configs/traefik/dynamic/local-certificate.yml

# ---------------------------------------------------------------------------
# TLS material
# ---------------------------------------------------------------------------
configs/traefik/certs/*
!configs/traefik/certs/.gitkeep
*.pem
*.key
*.crt
!**/dev-*.pem

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
node_modules/
.venv/
__pycache__/
*.log
.tmp/
